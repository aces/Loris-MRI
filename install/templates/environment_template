export PROJECT=%PROJECT%
export MINC_TOOLKIT_DIR=%MINC_TOOLKIT_DIR%

# Source the Python environment first so that other environment variables are added to it.
export LORIS_MRI=/opt/${PROJECT}/bin/mri
source /opt/${PROJECT}/bin/mri/.venv/bin/activate

# MINC is optional: Source the MINC toolkit if the MINC directory is found.
if [[ -n "$MINC_TOOLKIT_DIR" ]]; then
    source "$MINC_TOOLKIT_DIR/minc-toolkit-config.sh"
    export BEASTLIB=${MINC_TOOLKIT_DIR}/../share/beast-library-1.1
    export MNI_MODELS=${MINC_TOOLKIT_DIR}/../share/icbm152_model_09c
fi

umask 0002

# Export the LORIS-MRI paths after dependency environments have been configured.
export PATH=/opt/${PROJECT}/bin/mri/uploadNeuroDB:/opt/${PROJECT}/bin/mri/uploadNeuroDB/bin:/opt/${PROJECT}/bin/mri/dicom-archive:/opt/${PROJECT}/bin/mri/python/scripts:/opt/${PROJECT}/bin/mri/tools:/usr/local/bin/tpcclib:$PATH
export PERL5LIB=/opt/${PROJECT}/bin/mri/uploadNeuroDB:/opt/${PROJECT}/bin/mri/dicom-archive${PERL5LIB:+:$PERL5LIB}
export TMPDIR=/tmp
export LORIS_CONFIG=/opt/${PROJECT}/bin/mri/config
